# Configuration Exemple
# Copiez ce fichier en .env pour la configuration locale

# URL du site (pour le sitemap et les meta tags)
# NUXT_PUBLIC_SITE_URL=https://memolooper.com

# URL de l'App Store (quand disponible)
# NUXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/...

# Google Analytics ID (optionnel)
# NUXT_PUBLIC_GA_ID=G-XXXXXXXXXX
